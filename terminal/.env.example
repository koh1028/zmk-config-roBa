# ============================================================
# PERSONAL TERMINAL - 環境変数設定
# このファイルをコピーして .env.local を作成してください
# ============================================================

# ----- NextAuth -----
# openssl rand -base64 32 で生成
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# ----- Google OAuth -----
# Google Cloud Console > APIとサービス > 認証情報 で作成
# 必要なAPI: Google Calendar API, Gmail API
# リダイレクトURI: http://localhost:3000/api/auth/callback/google
#               http://localhost:3000/api/auth/google-second/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ----- Notion -----
# https://www.notion.so/my-integrations でインテグレーション作成
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion データベースID (URLの末尾 ?v= の前の32文字)
# TODO管理用データベース
# 必要なプロパティ: Name(title), Done(checkbox), Priority(select: high/medium/low), Due(date)
NOTION_TODO_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 日記用データベース
# 必要なプロパティ: Title(title), Date(date)
NOTION_DIARY_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# メモ用データベース
# 必要なプロパティ: Title(title), Tags(multi_select)
NOTION_MEMO_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
